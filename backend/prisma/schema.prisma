datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Roles e status usam String (compatibilidade histórica com SQLite; mantido
// assim ao migrar para PostgreSQL para não exigir alteração no código da app)
// com valores esperados: Role = "ADMIN" | "VOLUNTEER"; SlotStatus = "PENDING" | "CONFIRMED" | "DECLINED"

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  phone             String
  passwordHash      String
  role              String    @default("VOLUNTEER")
  active            Boolean   @default(true)
  // Dias da semana em que o voluntário está disponível para ser escalado
  // (0 = domingo ... 6 = sábado). Padrão: disponível todos os dias.
  availableWeekdays Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  createdAt         DateTime  @default(now())

  ministries     VolunteerMinistry[]
  unavailability Unavailability[]
  scheduleSlots  ScheduleSlot[]
}

model Ministry {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  volunteers    VolunteerMinistry[]
  eventNeeds    EventMinistryNeed[]
  scheduleSlots ScheduleSlot[]
}

model VolunteerMinistry {
  id         Int      @id @default(autoincrement())
  userId     Int
  ministryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([userId, ministryId])
}

model Event {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  createdAt DateTime @default(now())

  needs         EventMinistryNeed[]
  scheduleSlots ScheduleSlot[]
}

model EventMinistryNeed {
  id         Int      @id @default(autoincrement())
  eventId    Int
  ministryId Int
  slotsCount Int      @default(1)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([eventId, ministryId])
}

model Unavailability {
  id     Int       @id @default(autoincrement())
  userId Int
  date   DateTime
  // Data final do período bloqueado (inclusive). Nula = bloqueio de um único dia (igual a `date`).
  endDate DateTime?
  reason String?
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ScheduleSlot {
  id                Int       @id @default(autoincrement())
  eventId           Int
  ministryId        Int
  userId            Int
  status            String    @default("PENDING")
  notified          Boolean   @default(false)
  notifiedAt        DateTime?
  notificationError String?
  reminder24hSentAt DateTime?
  reminderDaySentAt DateTime?
  createdAt         DateTime  @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, ministryId, userId])
}
